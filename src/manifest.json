{
  "manifest_version": 2,
  "name": "Note It",
  "description": "Note It - A Free, Open Source, Minimalist Browser Extension for Students & Researchers",
  "version": "3.0",
  "background": {
    "page": "./background.html"
  },
  "browser_action": {
    "default_icon": "img/favicon.png",
    "default_popup": "popup.html"
  },
  "icons": {
    "32": "img/favicon.png"
  },
  "content_security_policy": "script-src 'self' object-src 'self'",
  "content_scripts": [
    {
      "js": ["src/contentScript/index.ts"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": ["contextMenus", "tabs", "activeTab", "storage", "downloads"],
  "web_accessible_resources": ["img/*.jpg"],
  "browser_specific_settings": {
    "gecko": {
      "id": "{a1083ace-8ea3-4035-9bf3-2eefc3ab351e}"
    }
  }
}
